#!/bin/sh /etc/rc.common

# OpenWRT init script for the homelab loadbalancer
# Controls the loadbalancer binary (default: /usr/bin/loadbalancer)
# The binary accepts -config /etc/homelab-lb/config.yaml by default (see main.go)

START=95
STOP=10
USE_PROCD=1

LOADBALANCER_BIN=${LOADBALANCER_BIN:-/usr/bin/loadbalancer}
CONFIG=${CONFIG:-/etc/homelab-lb/config.yaml}
NAME=homelab-lb

start_service() {
    if [ ! -x "$LOADBALANCER_BIN" ]; then
        echo "Cannot start $NAME: binary not found or not executable: $LOADBALANCER_BIN" >&2
        return 1
    fi

    echo "Starting $NAME using $LOADBALANCER_BIN -config $CONFIG"

    procd_open_instance
    # restart automatically if it exits
    procd_set_param command "$LOADBALANCER_BIN" -config "$CONFIG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    echo "Stopping $NAME"
    # Ask procd to stop managed instances of this command
    procd_killall TERM "$LOADBALANCER_BIN"
}

restart_service() {
    stop_service
    sleep 1
    start_service
}

status_service() {
    pid=$(pidof $(basename "$LOADBALANCER_BIN") 2>/dev/null)
    if [ -n "$pid" ]; then
        echo "$NAME is running (pid: $pid)"
        return 0
    else
        echo "$NAME is not running"
        return 3
    fi
}

# optional: allow overriding via /etc/default/homelab-lb (if you choose to create one)
[ -f /etc/default/homelab-lb ] && . /etc/default/homelab-lb

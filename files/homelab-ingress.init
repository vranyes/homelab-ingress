#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

SERVICE_BIN=${SERVICE_BIN:-/usr/bin/ingress}
NAME=homelab-ingress
GENERATED_CONFIG="/var/etc/${NAME}/config.yaml"

BASE_INTERFACE=
GRPC_LISTEN=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_ALLOWED_SUBJECTS=

append_subject() {
	AUTH_ALLOWED_SUBJECTS="${AUTH_ALLOWED_SUBJECTS} ${1}"
}

generate_config() {
	mkdir -p "/var/etc/${NAME}"

	{
		echo "---"
		echo "base_interface: ${BASE_INTERFACE}"
		echo "grpc:"
		echo "  listen: ${GRPC_LISTEN}"

		if [ -n "${AUTH_ISSUER}" ] && [ -n "${AUTH_ALLOWED_SUBJECTS}" ]; then
			echo "auth:"
			echo "  issuer: ${AUTH_ISSUER}"
			echo "  audience: ${AUTH_AUDIENCE}"
			echo "  allowed_subjects:"
			for subj in ${AUTH_ALLOWED_SUBJECTS}; do
				echo "    - ${subj}"
			done
		fi
	} > "${GENERATED_CONFIG}"
}

start_service() {
	config_load "${NAME}"

	config_get BASE_INTERFACE config base_interface
	config_get GRPC_LISTEN config grpc_listen "0.0.0.0:50051"
	config_get AUTH_ISSUER config auth_issuer ""
	config_get AUTH_AUDIENCE config auth_audience ""

	AUTH_ALLOWED_SUBJECTS=
	config_list_foreach config auth_allowed_subjects append_subject

	if [ -z "${BASE_INTERFACE}" ]; then
		echo "Cannot start ${NAME}: base_interface is required (set via UCI)" >&2
		return 1
	fi

	generate_config

	if [ ! -x "${SERVICE_BIN}" ]; then
		echo "Cannot start ${NAME}: binary not found: ${SERVICE_BIN}" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command "${SERVICE_BIN}" -config "${GENERATED_CONFIG}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	procd_killall TERM "${SERVICE_BIN}"
}

restart_service() {
	stop_service
	sleep 1
	start_service
}

service_triggers() {
	procd_add_reload_trigger "${NAME}"
}

reload_service() {
	restart_service
}

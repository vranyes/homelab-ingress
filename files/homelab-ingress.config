# UCI configuration for homelab-ingress ingress service
#
# Translated into /var/etc/homelab-ingress/config.yaml at startup by the init script.
# See /etc/homelab-ingress/config.yaml for the full YAML schema reference.

config service 'config'
	# (required) Network interface to bind load-balancer virtual IPs on
	option base_interface 'wan'
	option grpc_listen '0.0.0.0:50051'
	option auth_issuer 'https://myoidcissuer.local:6443'
	option auth_audience 'homelab-ingress'
	list auth_allowed_subjects 'system:serviceaccount:homelab-ingress:homelab-ingress-controller'
	list nat_iface 'br-lan'
	list nat_iface 'br-lan.10'

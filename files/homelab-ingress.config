# UCI configuration for the homelab-ingress ingress service
#
# The init script translates this file into
# /var/etc/homelab-ingress/config.yaml at every start; edit UCI, not the
# generated file. Every option below maps 1:1 onto a key in the YAML schema,
# which is installed as /etc/homelab-ingress/config.yaml.example (see
# ingress/README.md).
#
# Apply changes with:  /etc/init.d/homelab-ingress restart

config service 'config'
	# (required) Parent interface for the load-balancer macvlan interfaces.
	option base_interface 'wan'

	# Where the daemon keeps state.db, ca.pem and ca-key.pem. Must survive
	# reboots: the Kubernetes controller pins ca.pem in a Secret. Defaults to
	# /etc/homelab-ingress; set it explicitly to move state off the overlay.
	# option state_dir '/etc/homelab-ingress'

	# Omit either option to use the daemon's built-in default
	# (0.0.0.0:50051 / 0.0.0.0:50052).
	option grpc_listen '0.0.0.0:50051'
	option ws_listen '0.0.0.0:50052'

	# OIDC verification. All three are required.
	option auth_issuer 'https://myoidcissuer.local:6443'
	option auth_audience 'homelab-ingress'
	list auth_allowed_subjects 'system:serviceaccount:homelab-ingress:homelab-ingress-controller'
	# option auth_trusted_root_ca '/etc/homelab-ingress/oidc-ca.pem'

	# Masquerade rules for same-L2 traffic between VLANs.
	# Format: input_device,output_device
	# Generates: iifname "input" oifname "output" ct status dnat masquerade
	list masquerade 'br-lan.10,br-lan.20'
	# list masquerade 'br-lan.30,br-lan.40'

	# Geo-blocking (optional). Leave geoip_provider unset to disable it; then
	# Services carrying homelab-ingress.vranyes.com/allowed-geos are rejected.
	#
	# dbip: free, no key, monthly data (CC BY 4.0, https://db-ip.com).
	# maxmind: GeoLite2, needs a license key, daily data.
	# mock: e2e TSV fixture only -- never enable this in production.
	#
	# option geoip_provider 'dbip'
	# option geoip_license_key ''            # maxmind only
	# option geoip_edition 'GeoLite2-Country' # maxmind only
	# option geoip_refresh_interval '24h'
	# option geoip_stale_after '840h'
	# option geoip_download_url ''            # mirror / offline use
	# The database is ~5-10 MB and is rewritten on every refresh, so it
	# defaults to tmpfs (/var/lib/homelab-ingress/geo.mmdb) to spare the
	# overlay flash. Point it at /etc/homelab-ingress/geo.mmdb to survive
	# reboots without re-downloading.
	# option geoip_cache_path '/var/lib/homelab-ingress/geo.mmdb'
